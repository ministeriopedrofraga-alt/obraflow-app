:root {
  --ink: #14201b;
  --muted: #6d7772;
  --line: #e4e8e5;
  --soft: #f4f6f4;
  --canvas: #f7f8f6;
  --white: #ffffff;
  --green: #2f8f63;
  --green-dark: #206b49;
  --green-soft: #e7f5ee;
  --amber: #e29a27;
  --amber-soft: #fff3dc;
  --red: #cf5a4b;
  --red-soft: #fcedea;
  --blue: #3977b9;
  --blue-soft: #eaf3fb;
  --sidebar: #13231d;
  --shadow: 0 12px 32px rgba(26, 45, 36, .07);
  --radius: 14px;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body { margin: 0; color: var(--ink); background: var(--canvas); font-family: "DM Sans", Arial, sans-serif; font-size: 14px; }
button, input, select, textarea { font: inherit; }
button { cursor: pointer; }
svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
.app-shell { min-height: 100vh; }
.sidebar { position: fixed; inset: 0 auto 0 0; z-index: 30; display: flex; width: 252px; flex-direction: column; padding: 28px 18px 20px; color: #dbe5df; background: var(--sidebar); }
.brand { display: flex; align-items: center; gap: 12px; padding: 0 9px 32px; color: white; text-decoration: none; font: 700 18px Manrope, sans-serif; letter-spacing: -.5px; }
.brand > span:last-child { display: grid; line-height: 1; }
.brand strong { color: #65ca98; }
.brand small { margin-top: 6px; color: #769087; font: 700 8px DM Sans, sans-serif; letter-spacing: 2px; }
.brand-logo-img { max-height: 38px; width: auto; max-width: 120px; object-fit: contain; padding: 3px 6px; border-radius: 7px; background: white; box-shadow: 0 4px 10px rgba(0,0,0,0.15); }
.qr-brand-logo { display: block; max-height: 34px; width: auto; max-width: 150px; margin: 0 auto 10px; object-fit: contain; }
.main-nav { flex: 1; }
.nav-label { margin: 19px 11px 8px; color: #657b72; font-size: 10px; font-weight: 700; letter-spacing: 1.4px; }
.nav-link { display: flex; align-items: center; gap: 12px; min-height: 45px; margin: 3px 0; padding: 0 12px; border-radius: 9px; color: #9fb0a9; text-decoration: none; font-weight: 500; transition: .2s ease; }
.nav-link:hover { color: white; background: rgba(255,255,255,.05); }
.nav-link.active { color: white; background: #28493c; box-shadow: inset 3px 0 #63cd9a; }
.nav-link span { display: inline-flex; }
.nav-link b { min-width: 22px; margin-left: auto; padding: 3px 6px; border-radius: 8px; color: #75d6a7; background: rgba(103,205,156,.13); font-size: 11px; text-align: center; }
.sidebar-help { display: flex; gap: 10px; margin: 15px 2px; padding: 14px; border: 1px solid #31483f; border-radius: 11px; background: #1a2e26; }
.sidebar-help > span { color: #64cc9a; }
.sidebar-help div, .sidebar-user div { display: grid; min-width: 0; }
.sidebar-help strong { color: #e8efec; font-size: 12px; }
.sidebar-help small { margin-top: 3px; color: #869a92; font-size: 10px; line-height: 1.45; }
.sidebar-user { display: flex; align-items: center; gap: 10px; padding: 15px 5px 0; border-top: 1px solid #2c3c35; }
.sidebar-user strong { color: white; font-size: 12px; }
.sidebar-user small { margin-top: 3px; color: #7f938b; font-size: 10px; }
.avatar { display: grid; width: 35px; height: 35px; flex: 0 0 auto; place-items: center; border-radius: 50%; color: #163126; background: #72cda1; font-size: 11px; font-weight: 800; }
.sidebar-user .icon-button { margin-left: auto; color: #81958d; }
.main-area { min-height: 100vh; margin-left: 252px; }
.topbar { position: sticky; top: 0; z-index: 20; display: flex; height: 76px; align-items: center; justify-content: space-between; padding: 0 36px; border-bottom: 1px solid var(--line); background: rgba(255,255,255,.94); backdrop-filter: blur(12px); }
.site-selector { display: flex; align-items: center; gap: 10px; }
.site-selector div { display: grid; }
.site-selector small { color: #8a958f; font-size: 9px; font-weight: 700; letter-spacing: 1px; }
.site-selector strong { margin-top: 3px; font-size: 13px; }
.site-selector > svg { width: 15px; color: #87918d; }
.status-dot { width: 9px; height: 9px; border: 2px solid #cbf0dc; border-radius: 50%; background: #48b77f; box-shadow: 0 0 0 3px #e8f7ef; }
.top-actions { display: flex; align-items: center; gap: 12px; }
.global-search { display: flex; width: 315px; height: 40px; align-items: center; gap: 8px; padding: 0 11px; border: 1px solid var(--line); border-radius: 9px; color: #87918c; background: #fafbfa; }
.global-search svg { width: 17px; }
.global-search input { width: 100%; border: 0; outline: 0; color: var(--ink); background: transparent; font-size: 12px; }
.global-search kbd { padding: 3px 6px; border: 1px solid #e0e5e2; border-radius: 5px; color: #9ba49f; background: white; font: 10px sans-serif; white-space: nowrap; }
.icon-button { display: inline-grid; width: 36px; height: 36px; place-items: center; padding: 0; border: 0; border-radius: 9px; color: var(--muted); background: transparent; }
.icon-button:hover { background: var(--soft); }
.notification-button { position: relative; border: 1px solid var(--line); background: white; }
.notification-button i { position: absolute; top: 6px; right: 7px; width: 6px; height: 6px; border: 1px solid white; border-radius: 50%; background: #e46552; }
.button { display: inline-flex; min-height: 42px; align-items: center; justify-content: center; gap: 8px; padding: 0 17px; border: 1px solid transparent; border-radius: 9px; font-weight: 700; text-decoration: none; transition: .18s ease; }
.button:hover { transform: translateY(-1px); }
.button svg { width: 17px; }
.button-dark { color: white; background: #1b3028; box-shadow: 0 6px 12px rgba(17,43,32,.13); }
.button-green { color: white; background: var(--green); box-shadow: 0 6px 12px rgba(47,143,99,.16); }
.button-outline { border-color: var(--line); color: #3f4945; background: white; }
.button-ghost { color: #52605a; background: transparent; }
.button-danger { color: white; background: var(--red); }
.button.compact { min-height: 38px; padding: 0 14px; font-size: 12px; }
.button[hidden] { display: none !important; }
.mobile-menu { display: none; }
main { max-width: 1540px; margin: 0 auto; padding: 32px 36px 50px; }
.page-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: 27px; }
.eyebrow { margin: 0 0 7px; color: var(--green); font-size: 10px; font-weight: 800; letter-spacing: 1.3px; text-transform: uppercase; }
h1, h2, h3 { margin: 0; font-family: Manrope, sans-serif; }
h1 { font-size: 28px; letter-spacing: -.8px; }
h2 { font-size: 17px; letter-spacing: -.3px; }
h3 { font-size: 14px; }
.page-head p:not(.eyebrow) { margin: 7px 0 0; color: var(--muted); font-size: 13px; }
.page-actions { display: flex; gap: 9px; }
.module-tabs { display: flex; width: max-content; gap: 4px; margin: -10px 0 17px; padding: 4px; border: 1px solid var(--line); border-radius: 10px; background: #eef1ef; }
.module-tabs a { display: flex; min-height: 38px; align-items: center; gap: 7px; padding: 0 14px; border-radius: 7px; color: #68736d; text-decoration: none; font-size: 10px; font-weight: 700; }
.module-tabs a svg { width: 15px; }
.module-tabs a b { padding: 2px 5px; border-radius: 8px; color: var(--green-dark); background: var(--green-soft); font-size: 8px; }
.module-tabs a.active { color: var(--ink); background: white; box-shadow: 0 2px 7px rgba(21,40,31,.08); }
.metrics-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 15px; margin-bottom: 22px; }
.metric-card { position: relative; min-height: 125px; padding: 21px; overflow: hidden; border: 1px solid var(--line); border-radius: var(--radius); background: white; box-shadow: 0 4px 16px rgba(31,50,41,.025); }
.metric-top { display: flex; align-items: center; justify-content: space-between; color: var(--muted); font-size: 11px; font-weight: 600; }
.metric-icon { display: grid; width: 35px; height: 35px; place-items: center; border-radius: 9px; }
.metric-icon svg { width: 18px; }
.metric-icon.green { color: var(--green); background: var(--green-soft); }
.metric-icon.amber { color: #b97512; background: var(--amber-soft); }
.metric-icon.blue { color: var(--blue); background: var(--blue-soft); }
.metric-icon.red { color: var(--red); background: var(--red-soft); }
.metric-value { display: flex; align-items: baseline; gap: 8px; margin-top: 14px; }
.metric-value strong { font: 800 29px Manrope, sans-serif; letter-spacing: -1px; }
.metric-value small { color: var(--muted); font-size: 10px; }
.metric-bar { height: 3px; margin-top: 12px; overflow: hidden; border-radius: 4px; background: #edf0ee; }
.metric-bar span { display: block; height: 100%; border-radius: inherit; background: var(--green); }
.dashboard-grid { display: grid; grid-template-columns: minmax(0, 1.65fr) minmax(300px, .8fr); gap: 18px; }
.panel { border: 1px solid var(--line); border-radius: var(--radius); background: white; box-shadow: var(--shadow); }
.panel-head { display: flex; min-height: 66px; align-items: center; justify-content: space-between; padding: 0 20px; border-bottom: 1px solid #edf0ee; }
.panel-head p { margin: 3px 0 0; color: var(--muted); font-size: 11px; }
.panel-link { border: 0; color: var(--green-dark); background: transparent; font-size: 11px; font-weight: 700; }
.equipment-list { padding: 4px 12px 10px; }
.equipment-row { display: grid; grid-template-columns: 46px minmax(135px, 1.2fr) minmax(100px, .8fr) minmax(95px, .75fr) minmax(110px, 1fr) 105px 30px; gap: 11px; align-items: center; padding: 14px 8px; border-bottom: 1px solid #eff2f0; }
.equipment-row:last-child { border-bottom: 0; }
.equipment-thumb { display: grid; width: 43px; height: 43px; place-items: center; border-radius: 10px; color: #407058; background: #edf3ef; }
.equipment-thumb svg { width: 25px; height: 25px; }
.primary-text { display: grid; gap: 3px; min-width: 0; }
.primary-text strong { overflow: hidden; font-size: 12px; text-overflow: ellipsis; white-space: nowrap; }
.primary-text small, .cell-label { color: #89938e; font-size: 10px; }
.data-cell { display: grid; gap: 3px; font-size: 11px; }
.data-cell strong { font-size: 11px; font-weight: 600; }
.status { display: inline-flex; width: max-content; align-items: center; gap: 6px; padding: 5px 8px; border-radius: 15px; font-size: 9px; font-weight: 800; letter-spacing: .25px; text-transform: uppercase; }
.status::before { width: 5px; height: 5px; border-radius: 50%; background: currentColor; content: ""; }
.status.available { color: #287b55; background: var(--green-soft); }
.status.in-use { color: #aa6b12; background: var(--amber-soft); }
.status.maintenance { color: #b44c3f; background: var(--red-soft); }
.row-action { width: 30px; height: 30px; }
.activity-list { padding: 7px 19px 14px; }
.activity-item { position: relative; display: grid; grid-template-columns: 33px 1fr; gap: 11px; padding: 13px 0; }
.activity-item:not(:last-child)::after { position: absolute; top: 47px; bottom: -7px; left: 16px; width: 1px; background: #e5e9e7; content: ""; }
.activity-icon { z-index: 1; display: grid; width: 33px; height: 33px; place-items: center; border: 4px solid white; border-radius: 50%; color: var(--green); background: var(--green-soft); box-sizing: content-box; }
.activity-icon svg { width: 14px; }
.activity-icon.amber { color: #a56b18; background: var(--amber-soft); }
.activity-icon.blue { color: var(--blue); background: var(--blue-soft); }
.activity-content { min-width: 0; padding-top: 4px; }
.activity-content p { margin: 0; font-size: 11px; line-height: 1.45; }
.activity-content p strong { font-weight: 700; }
.activity-content small { display: block; margin-top: 4px; color: #949e99; font-size: 9px; }
.quick-actions { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 18px; }
.quick-card { display: flex; min-height: 84px; align-items: center; gap: 13px; padding: 16px; border: 1px solid var(--line); border-radius: 12px; color: inherit; background: white; text-align: left; }
.quick-card:hover { border-color: #b8d7c7; box-shadow: var(--shadow); }
.quick-card > span { display: grid; width: 40px; height: 40px; flex: 0 0 auto; place-items: center; border-radius: 10px; color: var(--green); background: var(--green-soft); }
.quick-card div { display: grid; gap: 4px; }
.quick-card strong { font-size: 12px; }
.quick-card small { color: var(--muted); font-size: 10px; }
.workspace-grid { display: grid; grid-template-columns: minmax(0,1.35fr) minmax(300px,.65fr); gap: 18px; }
.module-feature { display: grid; min-height: 350px; align-content: space-between; padding: 28px; border-radius: 18px; color: white; background: linear-gradient(145deg,#17382b,#245943); box-shadow: 0 18px 44px rgba(19,56,42,.15); }
.module-feature-top { display: flex; align-items: flex-start; justify-content: space-between; }
.module-big-icon { display: grid; width: 55px; height: 55px; place-items: center; border-radius: 14px; color: #173c2c; background: #77d5a8; }
.module-big-icon svg { width: 29px; height: 29px; }
.module-active { padding: 6px 9px; border: 1px solid rgba(255,255,255,.18); border-radius: 20px; color: #a9e3c5; background: rgba(255,255,255,.07); font-size: 9px; font-weight: 700; text-transform: uppercase; }
.module-feature .eyebrow { color: #80d8ae; }
.module-feature h2 { font-size: 25px; }
.module-description { max-width: 590px; margin: 9px 0 0; color: #bbcec5; line-height: 1.55; }
.module-stats { display: grid; grid-template-columns: repeat(4,1fr); margin: 24px 0; border-block: 1px solid rgba(255,255,255,.13); }
.module-stats span { display: grid; gap: 3px; padding: 16px 10px; border-right: 1px solid rgba(255,255,255,.13); }
.module-stats span:first-child { padding-left: 0; }
.module-stats span:last-child { border-right: 0; }
.module-stats strong { font: 800 20px Manrope,sans-serif; }
.module-stats small { color: #9bb4a9; font-size: 9px; }
.module-actions { display: flex; gap: 9px; }
.module-actions .button-outline { border-color: rgba(255,255,255,.2); color: white; background: rgba(255,255,255,.07); }
.future-modules { overflow: hidden; }
.future-module { display: grid; grid-template-columns: 39px 1fr auto; gap: 11px; align-items: center; padding: 18px 20px; border-bottom: 1px solid #edf0ee; }
.future-module:last-child { border-bottom: 0; }
.future-module > span { display: grid; width: 39px; height: 39px; place-items: center; border-radius: 10px; color: #728079; background: var(--soft); }
.future-module div { display: grid; gap: 3px; }
.future-module strong { font-size: 11px; }
.future-module small { color: var(--muted); font-size: 9px; }
.future-module b { color: #9ba49f; font-size: 8px; text-transform: uppercase; }
.future-module.module-link { width: 100%; border: 0; color: inherit; background: white; text-align: left; }
.future-module.module-link:hover { background: #f7faf8; }
.home-footer-card { display: flex; align-items: center; justify-content: space-between; margin-top: 18px; padding: 16px 19px; border: 1px solid var(--line); border-radius: 12px; background: white; }
.home-footer-card > div { display: flex; align-items: center; gap: 12px; }
.home-footer-card > div > span { display: grid; width: 36px; height: 36px; place-items: center; border-radius: 9px; color: var(--green); background: var(--green-soft); }
.home-footer-card > div div { display: grid; gap: 3px; }
.home-footer-card strong { font-size: 11px; }
.home-footer-card small { color: var(--muted); font-size: 9px; }
.dashboard-modules { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 14px; }
.dashboard-module-card { display: grid; grid-template-columns: 48px minmax(0,1fr) auto; min-height: 150px; gap: 16px; align-items: center; padding: 23px; border: 1px solid var(--line); border-radius: 15px; color: var(--ink); background: white; box-shadow: 0 7px 22px rgba(31,50,41,.045); text-align: left; transition: .18s ease; }
.dashboard-module-card:hover { transform: translateY(-2px); border-color: #b9d7c8; box-shadow: var(--shadow); }
.dashboard-module-card > span { display: grid; width: 48px; height: 48px; place-items: center; border-radius: 12px; color: var(--green); background: var(--green-soft); }
.dashboard-module-card.primary { border-color: #b9d7c8; background: linear-gradient(145deg,#f7fcf9,#fff); }
.dashboard-module-card.primary > span { color: white; background: var(--green); }
.dashboard-module-card div { min-width: 0; }
.dashboard-module-card div > small { color: var(--green); font-size: 8px; font-weight: 800; letter-spacing: 1.2px; }
.dashboard-module-card h2 { margin-top: 4px; font-size: 18px; }
.dashboard-module-card p { margin: 6px 0 0; color: var(--muted); font-size: 11px; line-height: 1.45; }
.dashboard-module-card > strong { display: grid; min-width: 78px; color: var(--green-dark); font: 800 25px Manrope,sans-serif; text-align: right; }
.dashboard-module-card > strong small { color: var(--muted); font: 500 9px DM Sans,sans-serif; }
.dashboard-attention { display: flex; align-items: center; gap: 12px; margin-top: 16px; padding: 15px 17px; border: 1px solid #efdfbf; border-radius: 12px; background: #fffaf1; }
.dashboard-attention > span { display: grid; width: 36px; height: 36px; place-items: center; border-radius: 9px; color: #a86d18; background: var(--amber-soft); }
.dashboard-attention div { display: grid; flex: 1; gap: 3px; }
.dashboard-attention strong { font-size: 11px; }
.dashboard-attention small { color: var(--muted); font-size: 9px; }
.app-standalone #dashboardInstallCard { display: none; }
.toolbar { display: flex; align-items: center; gap: 10px; margin-bottom: 16px; }
.search-box { display: flex; min-width: 260px; height: 42px; flex: 1; align-items: center; gap: 8px; padding: 0 13px; border: 1px solid var(--line); border-radius: 9px; color: #85908a; background: white; }
.search-box input { width: 100%; border: 0; outline: 0; background: transparent; }
.filter-select { height: 42px; padding: 0 34px 0 13px; border: 1px solid var(--line); border-radius: 9px; color: #4f5b55; outline: 0; background: white; }
.control-summary { display: flex; min-height: 49px; align-items: center; gap: 22px; margin-bottom: 13px; padding: 0 16px; border: 1px solid var(--line); border-radius: 10px; background: white; color: #5d6862; font-size: 10px; }
.control-summary span { display: flex; align-items: center; gap: 5px; }
.control-summary b { color: var(--ink); font-size: 12px; }
.control-summary i { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
.control-summary .summary-green { color: var(--green); }
.control-summary .summary-amber { color: var(--amber); }
.control-summary .summary-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; margin-left: auto; gap: 5px; }
.control-summary button { display: inline-flex; align-items: center; gap: 6px; padding: 7px 9px; border: 0; border-radius: 7px; color: var(--green-dark); background: transparent; font-size: 10px; font-weight: 700; }
.control-summary button:hover { background: var(--green-soft); }
.control-summary button svg { width: 14px; }
.simple-filters { display: grid; grid-template-columns: minmax(230px,1fr) 145px 190px 160px 150px; gap: 9px; margin-bottom: 13px; }
.simple-filters .search-box { min-width: 0; height: 48px; }
.filter-field { display: grid; height: 48px; align-content: center; padding: 4px 10px; border: 1px solid var(--line); border-radius: 9px; background: white; }
.filter-field span { color: #8b958f; font-size: 7px; font-weight: 700; text-transform: uppercase; }
.filter-field input, .filter-field select { min-width: 0; height: 24px; padding: 0; border: 0; outline: 0; color: #3f4b45; background: white; font-size: 10px; }
.compact-equipment-panel { overflow: hidden; box-shadow: none; }
.equipment-control-table td { vertical-align: middle; }
.equipment-identity { display: flex; min-width: 190px; align-items: center; gap: 10px; }
.equipment-identity > span { display: grid; width: 34px; height: 34px; flex: 0 0 auto; place-items: center; border-radius: 8px; color: #386650; background: #edf3ef; }
.equipment-identity > span svg { width: 19px; }
.equipment-identity div { display: grid; gap: 3px; }
.equipment-identity small, .table-sub { display: block; margin-top: 3px; color: #89938e; font-size: 8px; }
.control-row-actions { display: flex; align-items: center; justify-content: flex-end; gap: 5px; }
.control-row-actions .icon-button { border: 1px solid var(--line); }
.no-filter-results { display: none; padding: 28px; color: var(--muted); text-align: center; font-size: 11px; }
.workforce-summary { display: grid; grid-template-columns: 180px 210px 1fr; gap: 11px; margin-bottom: 16px; }
.workforce-summary > div { display: flex; min-height: 83px; align-items: center; gap: 12px; padding: 16px; border: 1px solid var(--line); border-radius: 11px; background: white; }
.workforce-summary > div > span { display: grid; width: 38px; height: 38px; flex: 0 0 auto; place-items: center; border-radius: 9px; color: var(--green); background: var(--green-soft); }
.workforce-summary p { display: grid; gap: 2px; margin: 0; }
.workforce-summary p strong { font: 800 20px Manrope,sans-serif; }
.workforce-summary p small, .workforce-summary p span { color: var(--muted); font-size: 9px; }
.workforce-summary .workforce-source p strong { font: 700 11px DM Sans,sans-serif; }
.workforce-source { justify-content: flex-start; }
.upload-zone { display: flex; align-items: center; gap: 12px; padding: 17px; border: 1.5px dashed #a8c9b8; border-radius: 11px; background: #f6faf8; cursor: pointer; }
.upload-zone > span { display: grid; width: 40px; height: 40px; flex: 0 0 auto; place-items: center; border-radius: 10px; color: var(--green); background: var(--green-soft); }
.upload-zone div { display: grid; flex: 1; gap: 3px; }
.upload-zone p { margin: 0; color: var(--muted); font-size: 9px; }
.upload-info { display: flex; align-items: center; gap: 9px; margin-top: 16px; padding: 12px; border-radius: 9px; background: var(--soft); }
.upload-info > span { color: var(--green); }
.upload-info div { display: grid; gap: 2px; }
.upload-info strong { font-size: 10px; }
.upload-info small { color: var(--muted); font-size: 9px; }
.import-columns { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
.import-columns span { padding: 6px 8px; border: 1px solid #d7e4dc; border-radius: 16px; color: #4c6256; background: #f7faf8; font-size: 8px; font-weight: 700; }
