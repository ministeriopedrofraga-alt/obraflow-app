  bottom: 24px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  min-width: 480px;
  max-width: 90vw;
  padding: 12px 20px;
  border: 1px solid rgba(255,255,255,0.15);
  border-radius: 12px;
  color: white;
  background: #14201b;
  box-shadow: 0 16px 36px rgba(0,0,0,0.35);
  animation: rise .25s ease;
}
.batch-bar-info { font-size: 13px; font-weight: 600; color: #aeb9b3; }
.batch-bar-info span { color: white; font-weight: 700; }
.batch-bar-actions { display: flex; align-items: center; gap: 8px; }

/* Signature Modal & Rubric Field Styles */
.operator-sign-field { grid-column: 1 / -1; }
.sign-field-row { margin-top: 5px; }
.sign-preview-box {
  display: flex;
  min-height: 48px;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 8px 16px;
  border: 2px dashed #a8b5ae;
  border-radius: 9px;
  background: white;
  cursor: pointer;
  transition: all .2s ease;
}
.sign-preview-box:hover { border-color: var(--green); background: var(--green-soft); }
.sign-placeholder-text { color: var(--green-dark); font-weight: 700; font-size: 13px; }
.sign-status-text { color: var(--muted); font-size: 11px; }
.sign-preview-img { max-height: 36px; max-width: 140px; object-fit: contain; }

.signature-modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 250;
  display: grid;
  place-items: center;
  padding: 16px;
  background: rgba(10, 22, 16, 0.72);
  backdrop-filter: blur(6px);
  animation: fade .2s ease;
}
.signature-modal-card {
  width: 100%;
  max-width: 500px;
  padding: 22px;
  border-radius: 18px;
  background: white;
  box-shadow: 0 20px 48px rgba(0,0,0,0.35);
  animation: rise .25s ease;
}
.signature-modal-head { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 14px; }
.signature-modal-head h3 { margin: 0; font-size: 18px; color: var(--ink); }
.signature-modal-head p { margin: 4px 0 0; color: var(--muted); font-size: 12px; }
.signature-canvas-wrap {
  position: relative;
  width: 100%;
  height: 200px;
  margin-bottom: 16px;
  border: 2px dashed #206b49;
  border-radius: 12px;
  background: #f7faf8;
  touch-action: none;
  overflow: hidden;
}
.signature-canvas-wrap canvas {
  display: block;
  width: 100%;
  height: 100%;
  cursor: crosshair;
}
.canvas-placeholder-hint {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  pointer-events: none;
  color: #8da196;
  font-size: 13px;
  font-weight: 600;
}
.signature-modal-foot { display: flex; align-items: center; justify-content: flex-end; gap: 9px; }

.paper-sign-cell-img { max-height: 20px; max-width: 55px; object-fit: contain; vertical-align: middle; }

.af-badge {
  display: inline-block;
  margin-left: 6px;
  padding: 2px 6px;
  border-radius: 4px;
  color: #1a4d36;
  background: #dcf2e6;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.3px;
  vertical-align: middle;
}

/* Entrada e saída de materiais: escolha clara entre digitação e planilha */
.material-launch-guide {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10px 18px;
  margin: 14px 0 18px;
  padding: 12px 16px;
  border: 1px solid #d9e7df;
  border-radius: 12px;
  color: #52635a;
  background: #f7fbf8;
  font-size: 12px;
}
.material-launch-guide > strong { color: var(--green-dark); font-size: 13px; }
.material-launch-guide span { display: inline-flex; align-items: center; gap: 7px; }
.material-launch-guide span b {
  display: inline-grid;
  width: 22px;
  height: 22px;
  place-items: center;
  border-radius: 50%;
  color: white;
  background: var(--green);
  font-size: 11px;
}
.material-method-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}
.material-method-card {
  display: grid;
  grid-template-columns: 46px minmax(0, 1fr) 20px;
  align-items: center;
  gap: 12px;
  min-height: 118px;
  padding: 18px;
  border: 1px solid #d7e2dc;
  border-radius: 14px;
  color: var(--ink);
  background: white;
  font: inherit;
  text-align: left;
  cursor: pointer;
  transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease;
}
.material-method-card:hover {
  transform: translateY(-2px);
  border-color: var(--green);
  box-shadow: 0 10px 24px rgba(20, 91, 61, .12);
}
.material-method-card > span {
  display: grid;
  width: 46px;
  height: 46px;
  place-items: center;
  border-radius: 12px;
  color: var(--green-dark);
  background: var(--green-soft);
}
.material-method-card.import > span { color: #1c5f96; background: #eaf4fc; }
.material-method-card > div { display: grid; gap: 6px; }
.material-method-card strong { font-size: 14px; }
.material-method-card small { color: var(--muted); font-size: 11px; line-height: 1.45; }
.material-method-card > b { color: #8a9991; }
.material-method-grid + .notice { margin-top: 14px; }

@media (max-width: 680px) {
  .material-method-grid { grid-template-columns: 1fr; }
  .material-method-card { min-height: 98px; }
  .material-launch-guide { align-items: flex-start; flex-direction: column; }
}
